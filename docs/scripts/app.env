# Per-app settings read by every script in this folder (copy to docs/scripts/app.env and fill in).
# Shell syntax; sourced by cap.sh / walk.sh / round.sh / probe.sh / logs.sh / gate.sh.
# Source of the values shown: GridSpace docs/scripts/r8.sh, walk.sh, DemoMode.kt (2026-10-13).

APP=gridspace                      # prefix of the global settings: ${APP}_demo, ${APP}_demo_ack, ${APP}_lang, ${APP}_rail ...
PKG=com.kejing.gridspace           # applicationId
DEMO_TAG=GridSpaceDemo             # logcat tag that logs "step <name>" markers (DemoMode.TAG)
APP_TAGS="GridSpaceEditor:I GridSpaceEntry:W"   # extra tags copied into <prefix>-demo-steps.txt
STOP_OTHERS="com.kejing.skyboxspatial"          # other spatial apps to force-stop before a capture (a leftover window sat in front of ours)
LANGS="zh en"                      # values accepted by ${APP}_lang; empty = single language

# Demo scripts (values of ${APP}_demo) used by round.sh
WORKBENCH_SCRIPT=sample            # opens the main scene and stops (no markers)
WALK_SCRIPT=walk                   # the full marker-driven walkthrough
EXPORT_SCRIPT=export               # exports and closes the editor (entry window reopens); empty = skip
PRE_SCRIPTS="newproject"           # extra ack-synced scripts run before the walk (space separated); empty = none
PLACEMENT_SETTINGS="brush rail selpanel popup probe"   # ${APP}_<name> overrides deleted at cleanup

# Device data to pull after a run (empty = skip)
EXPORT_DIR=/sdcard/Download/GridSpace    # MediaStore export folder on the device
EXPORT_EXT=vox
PRIVATE_DIR=files/projects               # app-private dir read with run-as; its index file:
PRIVATE_INDEX=index.json

# Waits (seconds) measured on the emulator: cold start after install / scaled cards settle / export script
COLD_START_S=40
WORKBENCH_S=45
EXPORT_S=28
CAP_TRIES=5                        # cap.sh retries per frame outside the walk (walk uses 8)
